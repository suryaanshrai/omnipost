# Copy this file to .env and fill in real values before running
# `docker compose up`. Nothing in this file is a working secret.

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
# The API's public hostname, e.g. api.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# The UI's origin, e.g. https://app.example.com
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=
# Leave true behind a TLS proxy. Set false only for a plain-HTTP local run.
DJANGO_SECURE_SSL_REDIRECT=true
# 127.0.0.1 keeps the API/UI ports private to the server (reach them through
# the TLS proxy). Use 0.0.0.0 only on a trusted local network.
BIND_ADDRESS=127.0.0.1

# Wraps every encrypted channel credential and BYOK provider key.
# Generate with: openssl rand -base64 32
OMNIPOST_KEK=change-me-to-a-base64-encoded-32-byte-key

# Postgres
DB_PASSWORD=change-me

# Redis
REDIS_PASSWORD=change-me

# Email: password reset and verification links. Without EMAIL_HOST, emails
# are only printed to the api container's log.
FRONTEND_URL=http://localhost:5173
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=OmniPost <no-reply@example.com>
# optional: verification email sent, sign-in allowed meanwhile.
# mandatory: no sign-in until the address is verified. none: no email.
ACCOUNT_EMAIL_VERIFICATION=optional
# Days a sign-in lasts before the user must sign in again (0 = forever).
AUTH_TOKEN_TTL_DAYS=30

# Media storage (S3-compatible: AWS S3, Cloudflare R2, MinIO, Backblaze B2).
# Leave AWS_STORAGE_BUCKET_NAME blank to keep media on local disk only — the
# API falls back to FileSystemStorage automatically (settings.py:S3_MEDIA_ENABLED).
# Credentials are read via boto3's standard env vars, never stored in settings.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
# Only needed for a non-AWS S3-compatible provider (R2/MinIO/B2).
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

# Set to your public API origin in production — used to build absolute media
# URLs handed to connectors (jobs/context.py). Irrelevant once S3-backed
# storage is configured, since that already returns absolute URLs.
PUBLIC_BASE_URL=http://localhost:8000

# AI (Phase 4). Both are optional: leave blank to disable the managed
# provider path entirely and require every workspace to bring its own key
# (Settings > AI providers in the app). ANTHROPIC_API_KEY powers the managed
# text features (brief -> variants, repurpose, alt text); OPENAI_API_KEY
# powers the managed image generation feature (Anthropic has no image API).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional overrides — sensible defaults are baked in otherwise.
# AI_TEXT_MODEL=claude-sonnet-5
# AI_IMAGE_MODEL=gpt-image-1
# AI_FREE_TEXT_LIMIT=3
# AI_FREE_IMAGE_LIMIT=1

# Gated platforms (Phase 6). Each is a managed OmniPost app, gated on that
# platform's own approval process (Meta Tech Provider Verification + app
# review, TikTok's Content Posting API audit) — see the revamp plan's
# "platform approvals" workstream. Leave blank until approved; connecting a
# channel for that platform fails clearly (PermanentError) rather than
# silently, until it's set. LinkedIn and X are NOT here — those run under
# each workspace's own OAuth app instead (see AppCredential / /app-credentials/),
# so there's no single server-wide secret for them.
META_APP_ID=
META_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Extra OAuth scopes for analytics (likes, views, impressions). Only add a
# scope once the platform has approved it for your app, then reconnect the
# channel. Suggested values:
#   LINKEDIN_EXTRA_SCOPES=r_member_social
#   THREADS_EXTRA_SCOPES=threads_manage_insights
#   META_EXTRA_SCOPES=instagram_manage_insights,read_insights
#   YOUTUBE_EXTRA_SCOPES=https://www.googleapis.com/auth/youtube.readonly
X_EXTRA_SCOPES=
LINKEDIN_EXTRA_SCOPES=
META_EXTRA_SCOPES=
THREADS_EXTRA_SCOPES=
YOUTUBE_EXTRA_SCOPES=

# Web app sign-in cookie. Lax works when the app and API share a site
# (app.example.com + api.example.com). Different sites: None (HTTPS only).
AUTH_COOKIE_SAMESITE=Lax

# Hosted billing (Stripe). Leave all blank when self-hosting: there are then
# no plans and no limits. Webhook endpoint: <API>/billing/webhook/, events
# checkout.session.completed and customer.subscription.*.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=
# Show plans on the landing page. true without Stripe = a fake door: the
# buttons collect "tell me when" emails (admin: Pricing interests).
CLOUD_PRICING_ENABLED=
PRICE_DISPLAY_CREATOR=$9/mo
PRICE_DISPLAY_PRO=$19/mo

# Observability (Phase 7). Both optional.
# Error reporting — blank disables Sentry entirely.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Bearer token for GET /metrics (Prometheus). The endpoint is off until set.
METRICS_AUTH_TOKEN=
# Switch off /admin + /django-rq, and the API docs (/schema/, /swagger-ui/).
ENABLE_ADMIN=true
ENABLE_API_DOCS=true

# Pin to a specific build for rollback (see DEPLOY.md#rolling-back).
# Blank runs whatever :latest points at.
IMAGE_TAG=
UI_IMAGE_TAG=

# Frontend
VITE_API_URL=http://localhost:8000
# The app's "Source code" link. Set it to your fork if you run modified code (AGPL §13).
SOURCE_URL=https://github.com/suryaanshrai/omnipost
